PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://previa_user:previa_password_2026@localhost:5432/previa_db?schema=public"

# Authentication & Security
JWT_ACCESS_SECRET=previa_super_secret_jwt_access_token_key_2026_dev_mode_secure
JWT_REFRESH_SECRET=previa_super_secret_jwt_refresh_token_key_2026_dev_mode_secure
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
COOKIE_SECRET=previa_cookie_secure_signature_salt_2026
CORS_ORIGIN=http://localhost:3000

# Object Storage: "local" (zero-config disk storage) or "s3" / "r2" (Cloudflare R2 or AWS S3)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=previa-storage
S3_FORCE_PATH_STYLE=false

# Caching & Queue (Redis + BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Malware Scanning: "mock" (built-in signature/heuristic scanner), "virustotal", or "clamav"
MALWARE_SCAN_PROVIDER=mock
VIRUSTOTAL_API_KEY=
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Initial Admin Seeding (auto-created on first run if no admin exists)
ADMIN_INITIAL_EMAIL=admin@previa.io
ADMIN_INITIAL_PASSWORD=AdminPass2026!
ADMIN_INITIAL_NAME="System Administrator"
